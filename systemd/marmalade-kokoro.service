[Unit]
Description=Marmalade TTS — Kokoro model daemon (kept in RAM)
After=network.target

[Service]
Type=simple
ExecStart=/home/max/.local/share/pipx/venvs/kokoro/bin/python \
    /home/max/.local/share/marmalade-tts/kokoro-daemon.py
Restart=on-failure
RestartSec=5
Environment=KOKORO_LANG=a

[Install]
WantedBy=default.target
