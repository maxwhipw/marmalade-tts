[Unit]
Description=Marmalade TTS — Coqui model daemon (kept in RAM)
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/share/coqui-venv/bin/python \
    %h/.local/share/marmalade-tts/daemon/coqui-daemon.py
Restart=on-failure
RestartSec=5
Environment=COQUI_MODEL=tts_models/en/ljspeech/tacotron2-DDC

[Install]
WantedBy=default.target
